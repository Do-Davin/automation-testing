{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Posts List",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["userId", "id", "title", "body"],
    "properties": {
      "userId": { "type": "integer", "minimum": 1 },
      "id":     { "type": "integer", "minimum": 1 },
      "title":  { "type": "string",  "minLength": 1 },
      "body":   { "type": "string",  "minLength": 1 }
    }
  }
}
